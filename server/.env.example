# Environment Configuration
ENV=

# Database Configuration
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SCHEMA=
DB_SSL_MODE=

# Server Configuration
SERVER_PORT=

# JWT Configuration
# Must be at least 32 bytes when ENV=prod
JWT_SECRET=
# Access token lifetime in hours (default 1)
ACCESS_TOKEN_HOURS=
# Refresh token lifetime in days (default 90)
REFRESH_TOKEN_DAYS=

# Logging Configuration
LOGGING_LEVEL=

# Comma separated proxy CIDRs whose X-Forwarded-For header is trusted, used for
# rate limiting by client IP. Leave empty to always use the direct peer address.
TRUSTED_PROXIES=

# Comma separated browser origins allowed by CORS. Defaults to the local dev
# server and the production frontend when unset.
CORS_ALLOWED_ORIGINS=
