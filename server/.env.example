# Environment Configuration
ENV=

# Database Configuration
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SCHEMA=
DB_SSL_MODE=

# Server Configuration
SERVER_PORT=

# JWT Configuration
# Must be at least 32 bytes when ENV=prod
JWT_SECRET=
ACCESS_TOKEN_HOURS=
REFRESH_TOKEN_DAYS=

# Logging Configuration
LOGGING_LEVEL=

# Comma separated proxy CIDRs whose X-Forwarded-For header is trusted, used for
# rate limiting by client IP. Leave empty to always use the direct peer address.
TRUSTED_PROXIES=